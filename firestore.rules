rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Usuário autenticado pode criar/ler/atualizar/excluir SOMENTE o próprio documento em /users/{userId}
    match /users/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;

      // Permitir acesso às subcoleções do usuário (investments, quiz, etc.)
      match /{subCollection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Coleções públicas (ex.: recomendações) - leitura pública
    match /public/{document=**} {
      allow read: if true;
    }

    // Negar tudo o mais por padrão
    match /{document=**} {
      allow read, write: if false;
    }
  }
}